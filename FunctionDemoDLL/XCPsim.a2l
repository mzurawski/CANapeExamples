    /begin MEASUREMENT triangleSignal "Triangle wave signal.\r\nSample rate: 100Hz"
      FLOAT64_IEEE NO_COMPU_METHOD 0 0 -10 10
      ECU_ADDRESS 0x1BD090
      FORMAT "%.15"
      SYMBOL_LINK "triangleSignal" 0
      /begin IF_DATA CANAPE_EXT
        100
        LINK_MAP "triangleSignal" 0x1BD090 0 0 0 1 0x2 0
        DISPLAY 0x0 -10 10
      /end IF_DATA
      /begin IF_DATA XCP
        /begin DAQ_EVENT FIXED_EVENT_LIST
          EVENT 0x04
        /end DAQ_EVENT
      /end IF_DATA
    /end MEASUREMENT

    /begin CHARACTERISTIC triangleSignalAmpl "Triangle wave signal amplitude.\r\n"
      VALUE 0x1C0090 __Double_Value_ColumnDir 0 NO_COMPU_METHOD -10 10
      FORMAT "%.15"
      SYMBOL_LINK "triangleSignalAmpl" 0
      /begin IF_DATA CANAPE_EXT
        100
        LINK_MAP "triangleSignalAmpl" 0x1C0090 0 0 0 1 0x2 0
        DISPLAY 0x0 -10 10
      /end IF_DATA
    /end CHARACTERISTIC

    /begin CHARACTERISTIC triangleSignalFreq "Triangle wave signal frequency.\r\nLimited to half of the sampling rate (50Hz) due to Nyquist sampling criterion.\r\n"
      VALUE 0x1C0088 __Double_Value_ColumnDir 0 NO_COMPU_METHOD 0 50
      FORMAT "%.15"
      SYMBOL_LINK "triangleSignalFreq" 0
      /begin IF_DATA CANAPE_EXT
        100
        LINK_MAP "triangleSignalFreq" 0x1C0088 0 0 0 1 0x2 0
        DISPLAY 0x0 0 50
      /end IF_DATA
    /end CHARACTERISTIC

    /begin MEASUREMENT triangleSignalPhase "Phase of the triangle wave signal.\r\nSample rate: 100Hz"
      FLOAT64_IEEE NO_COMPU_METHOD 0 0 0 1
      ECU_ADDRESS 0x1BD098
      FORMAT "%.15"
      SYMBOL_LINK "trianglePhase" 0
      /begin IF_DATA CANAPE_EXT
        100
        LINK_MAP "trianglePhase" 0x1BD098 0 0 0 1 0x2 0
        DISPLAY 0x0 0 1
      /end IF_DATA
      /begin IF_DATA XCP
        /begin DAQ_EVENT FIXED_EVENT_LIST
          EVENT 0x04
        /end DAQ_EVENT
      /end IF_DATA
    /end MEASUREMENT

