      /end AXIS_DESCR
      FORMAT "%.3"
      SYMBOL_LINK "curve4_8_uc" 0
      /begin IF_DATA CANAPE_EXT
        100
        LINK_MAP "curve4_8_uc" 0x1C098C 0 0 0 1 0x87 0
        DISPLAY 0x0 0 255
      /end IF_DATA
    /end CHARACTERISTIC

